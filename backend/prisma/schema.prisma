// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Warehouse {
  id       Int       @id @default(autoincrement())
  name     String
  sections Section[]
}

model Section {
  id          Int       @id @default(autoincrement())
  name        String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  warehouseId Int
  parent      Section?  @relation("SectionToSection", fields: [parentId], references: [id])
  parentId    Int?
  children    Section[] @relation("SectionToSection")
  batches     Batch[]
}

model Product {
  id         Int       @id @default(autoincrement())
  name       String
  // seco | refrigerado | congelado
  category   String
  // kg | unidad | caja | litro
  unit       String
  batches    Batch[]
  orderItems OrderItem[]
}

model Batch {
  id             Int      @id @default(autoincrement())
  product        Product  @relation(fields: [productId], references: [id])
  productId      Int
  section        Section  @relation(fields: [sectionId], references: [id])
  sectionId      Int
  quantity       Float
  entryDate      DateTime
  expirationDate DateTime
  allocations    OrderItemAllocation[]
}

model Client {
  id      Int     @id @default(autoincrement())
  name    String
  // almacen | restaurante | kiosco
  type    String
  address String
  orders  Order[]
}

model Order {
  id       Int         @id @default(autoincrement())
  client   Client      @relation(fields: [clientId], references: [id])
  clientId Int
  date     DateTime    @default(now())
  // pendiente_picking | listo_para_entregar
  status   String      @default("pendiente_picking")
  items    OrderItem[]
}

model OrderItem {
  id                 Int                    @id @default(autoincrement())
  order              Order                  @relation(fields: [orderId], references: [id])
  orderId            Int
  product            Product                @relation(fields: [productId], references: [id])
  productId          Int
  quantityRequested  Float
  allocations        OrderItemAllocation[]
}

model OrderItemAllocation {
  id                 Int       @id @default(autoincrement())
  orderItem          OrderItem @relation(fields: [orderItemId], references: [id])
  orderItemId        Int
  batch              Batch     @relation(fields: [batchId], references: [id])
  batchId            Int
  quantityAllocated  Float
  picked             Boolean   @default(false)
}
